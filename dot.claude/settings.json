{
  "enabledPlugins": {
    "dig@kuu-marketplace": true,
    "frontend-design@claude-plugins-official": true,
    "genshijin@genshijin": true,
    "natural-japanese@natural-japanese": true,
    "ponytail@ponytail": true,
    "superpowers@superpowers-marketplace": true
  },
  "env": {
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1",
    "ENABLE_LSP_TOOL": "1"
  },
  "extraKnownMarketplaces": {
    "genshijin": {
      "source": {
        "source": "git",
        "url": "https://github.com/interfacex-co-jp/genshijin.git"
      }
    },
    "kuu-marketplace": {
      "source": {
        "source": "git",
        "url": "https://github.com/fumiya-kume/claude-code.git"
      }
    },
    "natural-japanese": {
      "source": {
        "repo": "coji/natural-japanese",
        "source": "github"
      }
    },
    "ponytail": {
      "source": {
        "repo": "DietrichGebert/ponytail",
        "source": "github"
      }
    },
    "shiibar-cc": {
      "source": {
        "repo": "oppara/shiibar-cc",
        "source": "github"
      }
    },
    "superpowers-marketplace": {
      "source": {
        "repo": "obra/superpowers-marketplace",
        "source": "github"
      }
    }
  },
  "hooks": {
    "Notification": [
      {
        "hooks": [
          {
            "command": "agentoast hook claude",
            "type": "command"
          }
        ],
        "matcher": ""
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "command": "~/.claude/hooks/block-sensitive-reads.sh",
            "type": "command"
          }
        ],
        "matcher": "Bash"
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "command": "agentoast hook claude",
            "type": "command"
          }
        ],
        "matcher": ""
      }
    ]
  },
  "permissions": {
    "allow": [
      "Bash(curl * 127.0.0.1*)",
      "Bash(curl * localhost*)",
      "Bash(direnv allow*)",
      "Bash(rm -f /tmp/claude-*)"
    ],
    "ask": [
      "Bash(curl:*)",
      "Bash(mysql *)",
      "Bash(psql *)",
      "Bash(rm -r:*)",
      "Bash(rm:*)",
      "Bash(wget:*)"
    ],
    "defaultMode": "acceptEdits",
    "deny": [
      "Bash(*deploy*)",
      "Bash(aws * --no-cli-pager)",
      "Bash(chmod -R *)",
      "Bash(chmod 777 *)",
      "Bash(chown -R *)",
      "Bash(defaults write *)",
      "Bash(docker push *)",
      "Bash(find * -delete*)",
      "Bash(find * -exec rm*)",
      "Bash(gcloud * --quiet)",
      "Bash(git add -A)",
      "Bash(git add .)",
      "Bash(git checkout .)",
      "Bash(git clean -f *)",
      "Bash(git push --force *)",
      "Bash(git push -f *)",
      "Bash(git push:*)",
      "Bash(git rebase:*)",
      "Bash(git reset --hard *)",
      "Bash(git reset:*)",
      "Bash(helm install *)",
      "Bash(helm upgrade *)",
      "Bash(kill -9 *)",
      "Bash(killall *)",
      "Bash(kubectl apply *)",
      "Bash(kubectl delete *)",
      "Bash(mongod:*)",
      "Bash(nc:*)",
      "Bash(npm publish *)",
      "Bash(npm remove:*)",
      "Bash(npm uninstall:*)",
      "Bash(open *)",
      "Bash(osascript *)",
      "Bash(pkill *)",
      "Bash(pnpm publish *)",
      "Bash(rm -fr:*)",
      "Bash(rm -rf:*)",
      "Bash(rmdir:*)",
      "Bash(rsync:*)",
      "Bash(scp *)",
      "Bash(shred:*)",
      "Bash(ssh *)",
      "Bash(su:*)",
      "Bash(sudo:*)",
      "Bash(terraform apply *)",
      "Bash(terraform destroy *)",
      "Bash(unlink:*)",
      "Bash(yarn publish *)",
      "Edit(**/.env*)",
      "Edit(**/secrets/**)",
      "Edit(.bashrc)",
      "Edit(.env*)",
      "Edit(.ssh/**)",
      "Edit(.zshrc)",
      "Edit(secrets/**)",
      "Read(**/*.pem)",
      "Read(**/*key*)",
      "Read(**/*token*)",
      "Read(**/.env*)",
      "Read(**/credentials*)",
      "Read(**/secrets/**)",
      "Read(.config/gh/**)",
      "Read(.env*)",
      "Read(.git-credentials)",
      "Read(.ssh/**)",
      "Read(id_ed25519)",
      "Read(id_rsa)",
      "Read(secrets/**)",
      "mcp__supabase__execute_sql"
    ]
  },
  "sandbox": {
    "allowUnsandboxedCommands": true,
    "enabled": true,
    "filesystem": {
      "denyRead": [
        "~/.aws",
        "~/.bash_history",
        "~/.config/gcloud",
        "~/.gnupg",
        "~/.ssh",
        "~/.zsh_history"
      ]
    },
    "network": {
      "allowedDomains": [
        "*.githubusercontent.com",
        "*.npmjs.org",
        "github.com",
        "packagist.org",
        "pypi.org",
        "registry.yarnpkg.com"
      ]
    }
  },
  "statusLine": {
    "command": "deno run --allow-run=git ~/.claude/hooks/statusline.ts",
    "type": "command"
  },
  "theme": "auto"
}
